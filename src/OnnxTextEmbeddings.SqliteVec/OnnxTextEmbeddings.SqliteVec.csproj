<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>OnnxTextEmbeddings.NET.SqliteVec</PackageId>
    <Description>SQLite/sqlite-vec native semantic candidate search for OnnxTextEmbeddings.NET.</Description>
    <PackageTags>onnx;embeddings;semantic-search;sqlite;sqlite-vec</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>128x128_compressed.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OnnxTextEmbeddings/OnnxTextEmbeddings.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <PackageReference Include="sqlite-vec" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../128x128_compressed.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
